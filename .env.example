# =====================================================================
# Reduction Ladder for Code — Environment Configuration (.env)
# Copy this to .env and adjust variables as needed for your machine.
# =====================================================================

# --- Storage & Cache Directories ---
# Drive with ample storage for large model weights (e.g. D: or E: on Windows)
HF_HOME=D:/hf_cache
HF_CACHE_DIR=D:/hf_cache

# Local benchmark data & results directories
LADDER_CACHE_DIR=data/ladder
DISTILLATION_CACHE_DIR=data/distillation
RESULTS_DIR=results
CHECKPOINTS_DIR=checkpoints

# --- Models & Precision ---
STUDENT_MODEL=Qwen/Qwen2.5-Coder-1.5B-Instruct
QUANTIZATION=4bit_nf4

# --- Execution & Sandbox Settings ---
TIMEOUT_SECONDS=5.0

# --- Hardware / GPUs ---
CUDA_VISIBLE_DEVICES=0

# --- Optional API Keys & Tokens ---
HF_TOKEN=
WANDB_API_KEY=
